<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_product_delivery_smsa" model="product.product">
            <field name="name">SMSA Express Shipping</field>
            <field name="default_code">SM</field>
            <field name="type">service</field>
            <field name="categ_id" ref="delivery.product_category_deliveries"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">5</field>
            <field name="invoice_policy">order</field>
        </record>

        <record id="delivery_carrier_smsa_main" model="delivery.carrier">
            <field name="name">SMSA Express</field>
            <field name="product_id" ref="product_product_delivery_smsa"/>
            <field name="delivery_type">smsa</field>
<!--            <field name="fixed_price">0</field>-->
<!--            <field name="free_if_more_than" eval="True"/>-->
<!--            <field name="amount">1000</field>-->
        </record>

    </data>
</odoo>
