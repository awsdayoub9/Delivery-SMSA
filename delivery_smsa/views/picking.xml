<odoo>
    <record id="view_picking_form_smsa" model="ir.ui.view">
        <field name="name">stock.picking.form.smsa.scans</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_get_smsa_scans"
                        type="object"
                        string="Get SMSA Scans"
                        class="btn-primary"
                       />
            </header>

            <notebook position="inside">
                <page string="SMSA Tracking">
                    <field name="smsa_last_status" readonly="1"/>
                    <field name="smsa_scan_ids" invisible="state in ['done']">
                        <list editable="bottom">
                            <field name="awb"/>
                            <field name="scan_datetime"/>
                            <field name="scan_description"/>
                            <field name="scan_type"/>
                            <field name="city"/>
                            <field name="reference_id"/>
                            <field name="received_by"/>
                            <field name="scan_timezone"/>
                        </list>
                    </field>
                </page>
            </notebook>

        </field>
    </record>
</odoo>
